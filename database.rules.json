{
  "rules": {
    "peticiones": {
      ".read": "auth != null && auth.token.admin == true",
      ".write": false
    },
    "codigos": {
      ".read": "auth == null",
      ".write": false,
      "$codigo": {
        ".read": "auth == null"
      }
    },
    "muro": {
      ".read": true,
      ".write": false
    },
    "diagnostico": {
      ".read": false,
      ".write": "auth != null && auth.token.admin == true"
    }
  }
}
